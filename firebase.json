{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [{
          "source": "**/*.@(ttf|eot|svg|woff|woff2)",
          "headers": [{
          "key": "Access-Control-Allow-Origin",
          "value": "*"}]
        }],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
